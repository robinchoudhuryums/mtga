# Generated image-URL cache (regenerable via scripts/build_gallery.py)
.image-cache.json
# Incidental gallery preview screenshot
gallery-preview.png
# GitHub Pages build output (dashboard is rebuilt in CI from committed data)
_site/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Never commit Google service-account keys or other secrets
*service-account*.json
credentials*.json
.env

# Timestamped CSV snapshots written by sheets_sync.py pull before it overwrites
*.bak
# A temp file lib.atomic_write strands only if the process is killed between
# mkstemp and os.replace — never valid content, never commit it
*.tmp

# Personal Claude Code settings (permissions etc.) — not shared
.claude/settings.local.json

# pytest cache (unit-test layer)
.pytest_cache/
