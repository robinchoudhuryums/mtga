 "reasons": {
  "Hawkeye, Trick Shot": {
   "group": "Engine",
   "text": "IN THE DECK 2026-11-08 (for The Sentry). Every Hero entering deals damage equal to your Hero count; Tellah's Hero tokens trigger it too.",
   "graded_at": {
    "84": "9d96dfac21a7"
   }
  },
  "Wraith, Vicious Vigilante": {
   "group": "Strong",
   "text": "IN THE DECK 2026-11-08 (for Donatello). Unblockable double strike: Sword of Fire and Ice, Buster Sword, The Key to the Vault and SP//dr each trigger twice; the ideal lone attacker for Nick Fury, Spymaster.",
   "graded_at": {
    "84": "9d96dfac21a7"
   }
  },
  "Sword of Fire and Ice": {
   "group": "Strong",
   "text": "IN THE DECK 2026-11-08 (for Wondrous Revival). +2/+2, protection from red and blue, 2 damage and a card per hit; Liberator tutors it, First Avenger and Frodo attach it free.",
   "graded_at": {
    "84": "9d96dfac21a7"
   }
  },
  "Nahiri, Heir of the Ancients": {
   "group": "Strong",
   "text": "IN THE DECK 2026-11-08 (for War Machine). +1 makes a 1/1 and attaches an Equipment; −2 digs six for Equipment or Frodo (a Warrior); −3 deals twice the Equipment count (10).",
   "graded_at": {
    "84": "9d96dfac21a7"
   }
  },
  "Nick Fury, Spymaster": {
   "group": "Strong",
   "text": "IN THE DECK 2026-11-08 (for Team Transmitter). Attack alone: draw, then put a 3-or-less creature in tapped, attacking and indestructible (Hawkeye MM, Frodo, Kilo, Wraith, Matt Murdock).",
   "graded_at": {
    "84": "9d96dfac21a7"
   }
  },
  "Frodo, Determined Hero": {
   "group": "Strong",
   "text": "IN THE DECK 2026-11-08 (for Iron Man, Titan of Innovation). Attaches an MV 2-3 Equipment free on entry and attack (seven in the deck).",
   "graded_at": {
    "84": "9d96dfac21a7"
   }
  },
  "Hawkeye, Master Marksman": {
   "group": "Real",
   "text": "IN THE DECK 2026-11-08 (for Conqueror's Flail). 2-drop Hero; each tap buys unblockable, 2 damage or a loot, twice with Living Legend.",
   "graded_at": {
    "84": "9d96dfac21a7"
   }
  },
  "Kilo, Apogee Mind": {
   "group": "Engine",
   "text": "IN THE DECK 2026-11-08 (for Origin of Iron Man). Haste; proliferates whenever tapped, twice a turn with Living Legend.",
   "graded_at": {
    "84": "9d96dfac21a7"
   }
  },
  "Tellah, Great Sage": {
   "group": "Engine",
   "text": "IN THE DECK 2026-11-08 (for Cid). A 1/1 Hero token per noncreature spell (Hawkeye TS ping, Team Leader counter, Avengers Assemble draw); 4+ mana spells draw two.",
   "graded_at": {
    "84": "9d96dfac21a7"
   }
  },
  "Gideon Blackblade": {
   "group": "Strong",
   "text": "IN THE DECK 2026-11-08 (for Two-Handed Axe). 4/4 indestructible attacker on your turn; +1 gives indestructible, lifelink or vigilance.",
   "graded_at": {
    "84": "9d96dfac21a7"
   }
  },
  "Matt Murdock, Justice Seeker": {
   "group": "Real",
   "text": "IN THE DECK 2026-11-08 (for Mister Fantastic). {1} a combat for a counter; every creature with a counter has ward 1, Nick Fury included once he has one.",
   "graded_at": {
    "84": "9d96dfac21a7"
   }
  },
